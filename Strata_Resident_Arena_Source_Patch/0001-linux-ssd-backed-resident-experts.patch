diff --git a/include/strata/platform/file_backed_arena.hpp b/include/strata/platform/file_backed_arena.hpp
new file mode 100644
index 00000000..6cb12750
--- /dev/null
+++ b/include/strata/platform/file_backed_arena.hpp
@@ -0,0 +1,69 @@
+// Linux-only SSD-backed pageable arena. When the mapped bytes have been synced, the kernel may
+// reclaim clean expert pages and fault them from disk instead of swapping an anonymous copy.
+// This is a latency/memory-pressure tradeoff, not a RAM expansion or a guarantee of unchanged speed.
+#pragma once
+
+#include <cstddef>
+#include <string>
+
+#if defined(__linux__)
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <linux/magic.h>
+#include <sys/mman.h>
+#include <sys/vfs.h>
+#include <unistd.h>
+#include <vector>
+
+namespace strata::platform {
+
+inline void* create_file_backed_arena(const char* dir, size_t bytes, std::string& err) {
+    if (dir == nullptr || !*dir || bytes == 0) {
+        err = "SSD-backed resident arena requires a nonempty disk directory and nonzero size";
+        return nullptr;
+    }
+    struct statfs fs{};
+    if (statfs(dir, &fs) != 0 || fs.f_type == TMPFS_MAGIC || fs.f_type == RAMFS_MAGIC) {
+        err = "SSD-backed resident arena requires an existing disk directory (not tmpfs): " + std::string(dir);
+        return nullptr;
+    }
+    const std::string pattern = std::string(dir) + "/.strata-resident-XXXXXX";
+    std::vector<char> path(pattern.begin(), pattern.end());
+    path.push_back('\0');
+    const int fd = mkstemp(path.data());
+    if (fd < 0) {
+        err = "Cannot create SSD-backed resident arena: " + std::string(std::strerror(errno));
+        return nullptr;
+    }
+    // Unlink immediately, so a SIGKILL or an engine crash cannot leave a 20+ GiB orphan file.
+    (void) unlink(path.data());
+    // Reserve all extents to prevent SIGBUS from late ENOSPC while decoding.
+    const int allocation_error = posix_fallocate(fd, 0, (off_t) bytes);
+    void* view = MAP_FAILED;
+    if (allocation_error == 0)
+        view = mmap(nullptr, bytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    const int mapping_error = errno;
+    (void) ::close(fd);
+    if (view == MAP_FAILED) {
+        err = "Cannot allocate SSD-backed resident arena (need sufficient free disk space): " +
+              std::string(std::strerror(allocation_error ? allocation_error : mapping_error));
+        return nullptr;
+    }
+    return view;
+}
+
+inline bool sync_file_backed_arena(void* p, size_t bytes, std::string& err) {
+    if (msync(p, bytes, MS_SYNC) == 0) return true;
+    err = "Cannot sync resident arena to disk: " + std::string(std::strerror(errno));
+    return false;
+}
+
+inline void release_file_backed_arena(void* p, size_t bytes) {
+    if (p != nullptr) (void) munmap(p, bytes);
+}
+
+}  // namespace strata::platform
+#endif
diff --git a/tools/tests/test_file_backed_arena.cpp b/tools/tests/test_file_backed_arena.cpp
new file mode 100644
index 00000000..71fd00ed
--- /dev/null
+++ b/tools/tests/test_file_backed_arena.cpp
@@ -0,0 +1,26 @@
+// Standalone Linux test: c++ -std=c++17 -Iinclude tools/tests/test_file_backed_arena.cpp -o /tmp/test-file-arena
+#include "strata/platform/file_backed_arena.hpp"
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <sys/mman.h>
+#include <unistd.h>
+
+int main(int argc, char** argv) {
+    assert(argc == 2);  // pass an SSD-backed directory, NOT /dev/shm
+    std::string err;
+    constexpr size_t n = 256 * 1024;
+    auto* p = static_cast<unsigned char*>(strata::platform::create_file_backed_arena(argv[1], n, err));
+    if (!p) { std::fprintf(stderr, "%s\n", err.c_str()); return 1; }
+    for (size_t i = 0; i < n; ++i) p[i] = (unsigned char) (i * 7);
+    assert(strata::platform::sync_file_backed_arena(p, n, err));
+    assert(madvise(p, n, MADV_DONTNEED) == 0);
+    for (size_t i = 0; i < n; ++i) assert(p[i] == (unsigned char) (i * 7));
+    strata::platform::release_file_backed_arena(p, n);
+    err.clear();
+    assert(strata::platform::create_file_backed_arena("/dev/shm", n, err) == nullptr);
+    assert(!err.empty());
+    std::puts("file-backed resident arena: 3 checks passed (persist/reclaim/deny tmpfs)");
+    return 0;
+}
