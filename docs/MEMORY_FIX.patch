+    write({0x31455653, 2, 2, 1, 4}, sizeof bits);
+    check(records.open(file.string(), 4, 2, err), "retry after malformed input succeeds");
+    records.close();
+    fs::remove(file);
+    std::printf("mapped vision records: %d checks passed\n", checks);
