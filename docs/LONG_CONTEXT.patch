+set -eu
+if [[ "$1" == "--build" ]]; then
+    [[ "${TEST_FAIL:-0}" == "0" ]] || exit 42
+    printf '#!/bin/sh\\n# %s\\nexit 0\\n' "${TEST_MARKER}" > "$2/strata"
+    chmod +x "$2/strata"
+fi
+'''); cmake.chmod(0o755)
+            env = {**os.environ, 'PATH': str(root / 'bin') + os.pathsep + os.environ['PATH'],
